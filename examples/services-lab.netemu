      "config": {
        "hostname": "SRV",
        "interfaces": {
          "FastEthernet0": {
            "admin_up": true,
            "ip": "192.168.1.2/24",
            "description": "",
            "ipv6": [],
            "ipv6_enabled": true
          }
        },
        "gateway": "192.168.1.1",
        "dns": "192.168.1.2",
        "services": {
          "dhcp": {
            "enabled": true,
            "pools": [
              {
                "name": "LAN1",
                "network": "192.168.1.0/24",
                "gateway": "192.168.1.1",
                "dns": "192.168.1.2",
                "domain": "",
                "start": "192.168.1.100",
                "end": null,
                "lease": 86400
              },
              {
                "name": "LAN2",
                "network": "192.168.2.0/24",
                "gateway": "192.168.2.1",
                "dns": "192.168.1.2",
                "domain": "",
                "start": "192.168.2.100",
                "end": null,
                "lease": 86400
              }
            ],
            "excluded": [],
            "interfaces": null
          },
          "dns": {
            "enabled": true,
            "records": {
              "www.lab.local": "192.168.1.2",
              "srv.lab.local": "192.168.1.2"
            }
          },
          "http": {
            "enabled": true,
            "pages": {
              "index.html": "<html><body><h1>NetEmu lab web server</h1><p>DHCP, DNS and HTTP work.</p></body></html>"
            }
          }
        }
      },
      "startup": null
